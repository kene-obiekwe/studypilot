# Base URL of the Django API, including the /api prefix. Copy to .env.local for local work.
# Required for `npm run build`: the value is inlined into the bundle at build time and the
# build fails if it is missing. `npm run dev` falls back to http://127.0.0.1:8000/api.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# Optional error tracking with Sentry (errors only, no personal data). Leave blank to turn it off.
# Use the browser project's DSN. Inlined at build time, so a change needs a redeploy. See docs/deploy.md.
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to "production" in a production build and "development" otherwise.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
