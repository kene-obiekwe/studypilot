# Base URL of the Django API, including the /api prefix. Copy to .env.local for local work.
# Required for `npm run build`: the value is inlined into the bundle at build time and the
# build fails if it is missing. `npm run dev` falls back to http://127.0.0.1:8000/api.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
