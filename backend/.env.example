# Copy to backend/.env for local development. Never commit real secrets.

# True/true/1 enables debug mode. Defaults to False, so leave unset (or False) in production.
DEBUG=True
# Django secret key. Required when DEBUG is False; in development a built-in dev key is used if unset.
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
# Comma-separated hostnames this server may serve. Defaults to 127.0.0.1,localhost.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated frontend origins allowed to call the API (CORS). Unset: localhost:3000 in debug, none in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated origins trusted for CSRF (include the scheme). Unset: localhost:3000 in debug, none in production.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. A DATABASE_URL, when set, wins over DB_ENGINE and the DB_* values below.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# sqlite or postgres, used when DATABASE_URL is not set.
DB_ENGINE=sqlite
# PostgreSQL connection values, used when DB_ENGINE=postgres (these match docker-compose.yml).
DB_NAME=fyp_db
DB_USER=fyp_user
DB_PASSWORD=fyp_pass
DB_HOST=127.0.0.1
DB_PORT=55432

# Path to the adherence model file; relative paths resolve against backend/. Defaults to ml/models/oulad_adherence_forecast.joblib.
# ADHERENCE_MODEL_PATH=ml/models/oulad_adherence_forecast.joblib

# Rate limit for register, token and token-refresh requests per client IP (count/second|minute|hour|day). Defaults to 10/minute.
AUTH_THROTTLE_RATE=10/minute

# Console log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Production only (ignored when DEBUG is True):
# Redirect HTTP to HTTPS. Defaults to True.
# SECURE_SSL_REDIRECT=True
# Seconds for the Strict-Transport-Security header. Defaults to 3600.
# SECURE_HSTS_SECONDS=3600
