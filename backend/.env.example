# Copy to backend/.env for local development. Never commit real secrets.

# True/true/1 enables debug mode. Defaults to False, so leave unset (or False) in production.
DEBUG=True
# Django secret key. Required when DEBUG is False; in development a built-in dev key is used if unset.
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
# Comma-separated hostnames this server may serve. Defaults to 127.0.0.1,localhost.
# On Render the service's own RENDER_EXTERNAL_HOSTNAME is added automatically.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated frontend origins allowed to call the API (CORS). Unset: localhost:3000 in debug, none in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated origins trusted for CSRF (include the scheme). Unset: localhost:3000 in debug, none in production.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. A DATABASE_URL, when set, wins over DB_ENGINE and the DB_* values below.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# sqlite or postgres, used when DATABASE_URL is not set.
DB_ENGINE=sqlite
# PostgreSQL connection values, used when DB_ENGINE=postgres (these match docker-compose.yml).
DB_NAME=fyp_db
DB_USER=fyp_user
DB_PASSWORD=fyp_pass
DB_HOST=127.0.0.1
DB_PORT=55432

# Path to the adherence model file; relative paths resolve against backend/. Defaults to ml/models/oulad_adherence_forecast.joblib.
# ADHERENCE_MODEL_PATH=ml/models/oulad_adherence_forecast.joblib

# Rate limit for register, token and token-refresh requests per client IP (count/second|minute|hour|day). Defaults to 10/minute.
AUTH_THROTTLE_RATE=10/minute

# Optional AI-written weekly plans and course-trait suggestions. Off unless the API key is set;
# without it the app serves rules-only plans and keyword-based suggestions. Never commit a real key.
# ANTHROPIC_API_KEY=
# Model for AI plans. Defaults to claude-haiku-5-5.
AI_PLAN_MODEL=claude-haiku-5-5
# Model calls allowed per user per day (cache hits and rules-only plans don't count). Defaults to 20.
AI_PLAN_DAILY_LIMIT=20
# Seconds before a model call gives up and the rules-only plan is served. Defaults to 20.
AI_PLAN_TIMEOUT_SECONDS=20

# JWT lifetimes. Access tokens default to 30 minutes, refresh tokens to 1 day (no rotation).
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Password the demo seeder (manage.py seed_pilot_data) gives the pilot accounts. Development only:
# when unset and DEBUG is True it uses a built-in default. With DEBUG off the seeder refuses to run
# unless --allow-production is passed and this is set to a strong password.
# PILOT_PASSWORD=

# Rate limit for the email-sending endpoints (verify, resend, password reset) per client IP. Defaults to 5/hour.
EMAIL_THROTTLE_RATE=5/hour

# Outgoing email for verification and password-reset codes. With DEBUG on and no EMAIL_BACKEND set,
# emails are printed to the server console. With DEBUG off the SMTP backend is used.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP server name and port.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# SMTP login. Leave blank for a server that needs none.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# True to upgrade the connection with STARTTLS (the usual setting for port 587).
# EMAIL_USE_TLS=True
# Seconds to wait for the mail server before giving up on a send. Defaults to 10.
# EMAIL_TIMEOUT=10
# The From address on every email. Defaults to StudyPilot <no-reply@localhost>.
# DEFAULT_FROM_EMAIL=StudyPilot <no-reply@example.com>

# Console log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO

# Production only (ignored when DEBUG is True):
# Redirect HTTP to HTTPS. Defaults to True.
# SECURE_SSL_REDIRECT=True
# Seconds for the Strict-Transport-Security header. Defaults to 3600.
# SECURE_HSTS_SECONDS=3600

# Optional error tracking with Sentry (errors only, no personal data). Leave blank to turn it off; use the backend project's DSN.
SENTRY_DSN=
